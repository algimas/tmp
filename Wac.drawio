        <mxCell id="7VRETilZOHFnB1T0Wc80-28" parent="1" style="shape=mxgraph.archimate3.application;archiType=square;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;appType=passive;fillColor=#b5d8a8;strokeColor=#4d7a3a;fontStyle=1;" value="pm_project.work_cost = Actual cost&lt;br&gt;visible on the project, Financials, workspace, reports" vertex="1">
