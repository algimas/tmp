    <mxGraphModel dx="1342" dy="799" grid="0" gridSize="10" guides="0" tooltips="1" connect="0" arrows="0" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="DPDrP7-kFXSetGJKnKpo-0" />
        <mxCell id="DPDrP7-kFXSetGJKnKpo-1" parent="DPDrP7-kFXSetGJKnKpo-0" />
        <mxCell id="rsvPj1cRMHHYBMWNH137-0" parent="DPDrP7-kFXSetGJKnKpo-1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" value="&lt;b&gt;Proposal P1 - read-only reader group&lt;/b&gt;&lt;br&gt;Group ITBM_Readers grants sn_ppm_finance_read.&lt;div&gt;Q1:&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- We want to have a &quot;reading Demand Requester for all Demands and Projects&quot;, but read-only. He should not be allowed to create or update anything. Without getting the Demand Manager Role.&lt;/span&gt;&lt;/div&gt;" vertex="1">
