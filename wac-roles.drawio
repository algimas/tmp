        <mxCell id="y578fc2lkKVI6xUaZfkh-111" parent="RGOiq4gey57imG2aMLxf-1" style="html=1;outlineConnect=0;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=passive;archiType=square;verticalAlign=top;align=left;spacingLeft=6;spacingRight=24;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Budget lines of portfolios (project_funding): create, write, delete&lt;/b&gt;&lt;br&gt;Fields allocated, capex and opex budget and target, fiscal period, planned.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Planned flag of demands and projects: read, write&lt;/b&gt; (dmn_demand.planned, pm_project.planned)&lt;br&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Portfolio of programs, primary portfolio of projects: write&lt;/b&gt; (pm_program.portfolio, pm_project.primary_portfolio)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Cost plan breakdowns: budget and target: write. Decisions (dmn_decision), portfolio scenarios, planning windows: create, write, delete.&lt;/b&gt;&lt;br&gt;Portfolio and program records themselves stay with wacker_dcm and wacker_pmo (custom ACLs), the merge does not touch them.&lt;/div&gt;" vertex="1">
          <mxGeometry height="198" width="337" x="620" y="41" as="geometry" />
