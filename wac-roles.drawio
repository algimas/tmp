        <mxCell id="y578fc2lkKVI6xUaZfkh-109" parent="RGOiq4gey57imG2aMLxf-1" style="html=1;outlineConnect=0;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=passive;archiType=square;verticalAlign=top;align=left;spacingLeft=6;spacingRight=24;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;IT financial plans (itfm_plan, itfm_plan_item ...): create, write, delete&lt;/b&gt;" vertex="1">
