        <mxCell id="rsvPj1cRMHHYBMWNH137-18" parent="DPDrP7-kFXSetGJKnKpo-1" style="html=1;outlineConnect=0;whiteSpace=wrap;shape=mxgraph.archimate3.application;appType=role;archiType=square;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;" value="pa_viewer" vertex="1">
