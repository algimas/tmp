        <mxCell id="xwV2WR7dLGXC9FgV4xtg-52" edge="1" parent="1" source="xwV2WR7dLGXC9FgV4xtg-27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;" target="xwV2WR7dLGXC9FgV4xtg-28" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="xwV2WR7dLGXC9FgV4xtg-53" edge="1" parent="1" source="xwV2WR7dLGXC9FgV4xtg-29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;" target="xwV2WR7dLGXC9FgV4xtg-30" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="xwV2WR7dLGXC9FgV4xtg-54" edge="1" parent="1" source="xwV2WR7dLGXC9FgV4xtg-30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;" target="xwV2WR7dLGXC9FgV4xtg-31" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="xwV2WR7dLGXC9FgV4xtg-55" edge="1" parent="1" source="xwV2WR7dLGXC9FgV4xtg-32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;" target="xwV2WR7dLGXC9FgV4xtg-33" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="xwV2WR7dLGXC9FgV4xtg-56" edge="1" parent="1" source="xwV2WR7dLGXC9FgV4xtg-33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#333333;endArrow=block;endFill=1;" target="xwV2WR7dLGXC9FgV4xtg-34" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EcFpZKYzLTuGyb1L56OT-1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=4;" value="&lt;div&gt;&lt;b&gt;strategic - Evaluation&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;In &lt;b&gt;Dmgmt&lt;/b&gt;:&amp;nbsp;&lt;/div&gt;&lt;div&gt;Gate 1 moves a new demand to Initialization. Any one member of the Divisional Business Partner group decides.&amp;nbsp;&lt;/div&gt;&lt;div&gt;Gate 2 follows only for Normal demands with strategic impact &quot;Yes - with Gate2&quot;.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;In OOTB: the &lt;b&gt;Screening&lt;/b&gt; state. One person with the &lt;b&gt;demand_manager&lt;/b&gt; role screens the demand and clicks Qualify, or Defer or Close. There is no approval record.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Why here:&lt;/b&gt; this is the first and cheapest filter. We check fit, category and strategic relevance before anyone spends effort on design or cost.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Open&lt;/b&gt;: Dmgmt decides by group and can add a second stage. OOTB decides by one click.&lt;/div&gt;" vertex="1">
          <mxGeometry height="223" width="467" x="504" y="-364" as="geometry" />
        </mxCell>
        <mxCell id="EcFpZKYzLTuGyb1L56OT-2" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=4;" value="&lt;div&gt;&lt;b&gt;tactical - Refinement&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;In &lt;b&gt;Dmgmt&lt;/b&gt;: the Planning &amp;amp; Design state. The team works out design, effort and cost, then presses Request Authorization. Dmgmt has no approval of its own at this step.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;In OOTB: the &lt;b&gt;Qualified&lt;/b&gt; state. The assessment scoring, resource plan, cost plan, goals and stakeholders are filled in here. Incomplete sends the demand back to the requester for more information.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Why here&lt;/b&gt;: the concept is worked out and checked before anyone is asked for the final go.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Note&lt;/b&gt;: the Excel cost reload and effort roll-up of Dmgmt are not carried over. OOTB has its own cost plan.&lt;/div&gt;" vertex="1">
          <mxGeometry height="196" width="475" x="501" y="-117" as="geometry" />
        </mxCell>
        <mxCell id="EcFpZKYzLTuGyb1L56OT-3" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=middle;spacing=4;" value="&lt;div&gt;&lt;b&gt;operational - Approval Board&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;In &lt;b&gt;Dmgmt&lt;/b&gt;: the &lt;b&gt;Authorization&lt;/b&gt; state. The EA step comes first, then a Gate group built per demand. All its members must approve. The 2023 process document names a DSC / RPB board for this step.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;In OOTB: the &lt;b&gt;Approved&lt;/b&gt; state. One click by demand_approver or demand_manager. Create Project then hands the work to a project.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Why here:&lt;/b&gt; this is the last gate before delivery is released. No project starts without it.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Open&lt;/b&gt;: Dmgmt needs all approvers, OOTB takes one click.&lt;/div&gt;" vertex="1">
          <mxGeometry height="196" width="467" x="505" y="103" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
