        <mxCell id="vabRqZXuF9KGcR5PjotK-14" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;spacing=4;" value="&lt;b&gt;Path by type (demand_type)&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;&lt;b&gt;Normal Demand&lt;/b&gt;: Gate 1, Gate 2 only with strategic impact &#39;Yes - with Gate2&#39;, Authorization approvals (EA, Gate group)&lt;br&gt;&lt;b&gt;Small&lt;/b&gt;: Gate 1, Gate 2 skipped, Authorization skipped &amp;nbsp;|&amp;nbsp; &lt;b&gt;Fast-Track&lt;/b&gt;: Authorization skipped&lt;br&gt;&lt;b&gt;DSC Info only, Digital Accelerator&lt;/b&gt;: no Authorization branch (stuck, 3 records)&lt;br&gt;&lt;b&gt;BPCR&lt;/b&gt;: no approval until Authorization (group manager, impacted groups) &amp;nbsp;|&amp;nbsp; &lt;b&gt;Feature Request&lt;/b&gt;: Initialization approval, Jira, Complete&lt;/font&gt;" vertex="1">
          <mxGeometry height="105" width="1010" x="-196" y="1042" as="geometry" />
        </mxCell>
