        <mxCell id="vabRqZXuF9KGcR5PjotK-13" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=center;verticalAlign=middle;spacing=4;" value="&lt;b&gt;Override buttons&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;role business_partner: 0 holders on DEV&lt;br&gt;Force Execution (2, -3, -4, -5, -7, -9 to -5)&lt;br&gt;Restart (to New)&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="330" x="884" y="862" as="geometry" />
